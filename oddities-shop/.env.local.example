# ── Supabase ─────────────────────────────────────────────────────────────────
# Server-side (service role — never expose to client)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Client-side (anon key — safe to expose, NEXT_PUBLIC_ is inlined at build time)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ── Square ────────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=XXXXXXXXXXXXXXXX
# "production" for live payments; omit or set to anything else for sandbox
SQUARE_ENV=production
# Found in Square Developer Dashboard → Webhooks → your endpoint → Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=...

# ── Site URL (used for Square redirect + webhook HMAC) ────────────────────────
# Must match the URL registered in your Square webhook endpoint exactly
NEXT_PUBLIC_SITE_URL=https://coldbratpokes-shop.vercel.app

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_UPLOAD_PASSWORD=choose-a-strong-password-here
